# Copy to .env:  Copy-Item .env.example .env
#
# Which services `docker compose up -d` starts.
#   solo        the whole Hub in one container (lightest)
#   stages      one container per stage, the production-shaped topology
#   obs         Prometheus + Grafana  -> http://localhost:3000
#   elk         Elasticsearch, Kibana, Filebeat -> http://localhost:5601
# `solo` and `stages` are alternatives; do not run both.
COMPOSE_PROFILES=solo,obs,elk

ELASTIC_VERSION=8.15.3

# functional | ci | performance  — how much of each payment is logged.
HUB_TRACKING_MODE=functional
HUB_LOG_LEVEL=INFO

# functional | ci | performance  — how the emulated FIN, SnF and FCC behave.
ESS_MODE=functional

# Where the ESS finds the Hub. Override when using the `stages` profile:
#   HUB_EDGE=hub-edge:8443
#   HUB_STATUS_API=http://hub-status-api:8080
HUB_EDGE=hub:8443
HUB_STATUS_API=http://hub:8080
