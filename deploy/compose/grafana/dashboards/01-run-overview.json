{
  "uid": "hub-run-overview",
  "title": "1 · Run overview",
  "tags": ["payment-hub", "perf"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "description": "The panel to watch during a run. NOTE: TPS here is the Hub's own view from hub_payments_state_total. The authoritative figures are the ESS recorder's T4 handoff and the status tracker's T6 completion (performance-testing.md 2.1); ess_transactions_total is not built yet.",
  "templating": {
    "list": [
      {
        "name": "format",
        "label": "Format",
        "type": "custom",
        "query": ".*,MT,MX",
        "current": { "text": ".*", "value": ".*" },
        "options": [
          { "text": ".*", "value": ".*", "selected": true },
          { "text": "MT", "value": "MT", "selected": false },
          { "text": "MX", "value": "MX", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "TPS in and out, by format",
      "description": "Received vs completed transactions per second. A gap that widens means work is accumulating.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "hub:received_tps{format=~\"$format\"}",
          "legendFormat": "received · {{format}}"
        },
        {
          "refId": "B",
          "expr": "hub:completed_tps{format=~\"$format\"}",
          "legendFormat": "completed · {{format}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Completed TPS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [{ "refId": "A", "expr": "sum(hub:completed_tps)" }]
    },
    {
      "type": "stat",
      "title": "Achieved ratio",
      "description": "completed / received. SLO: >= 0.98",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "refId": "A", "expr": "hub:achieved_ratio" }]
    },
    {
      "type": "stat",
      "title": "Technical error rate",
      "description": "SLO: < 0.01%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "refId": "A", "expr": "hub:error_ratio" }]
    },
    {
      "type": "stat",
      "title": "Held (awaiting FCC)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(hub_held_payments)" }]
    },
    {
      "type": "stat",
      "title": "Cover legs waiting",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(hub_pending_cover_legs)" }]
    },
    {
      "type": "row",
      "title": "End-to-end latency (T0 → T6)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "End-to-end latency percentiles, by format",
      "description": "SLO: pacs.008 p95 < 1.5 s, p99 < 3 s. The gate recomputes these from the per-UETR rows over the exact steady window — this panel is indicative.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.5 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, format) (rate(hub_payment_end_to_end_seconds_bucket{format=~\"$format\"}[1m])))",
          "legendFormat": "p50 · {{format}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, format) (rate(hub_payment_end_to_end_seconds_bucket{format=~\"$format\"}[1m])))",
          "legendFormat": "p95 · {{format}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, format) (rate(hub_payment_end_to_end_seconds_bucket{format=~\"$format\"}[1m])))",
          "legendFormat": "p99 · {{format}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "State transitions per second",
      "description": "Every state change on hub.pay.status. HELD, BLOCKED, REJECTED and FAILED are the ones to watch.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (rate(hub_payments_state_total{format=~\"$format\"}[1m]))",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Failures",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }
    },
    {
      "type": "timeseries",
      "title": "Errors by stage and code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, error_code) (rate(hub_payments_errors_total[1m]))",
          "legendFormat": "{{stage}} · {{error_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retry ladder and DLQ",
      "description": "Records sent to <topic>.retry.30s, .retry.5m and .dlq. Anything on a .dlq needs a human.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target) (rate(hub_payments_retried_total[1m]))",
          "legendFormat": "{{target}}"
        }
      ]
    }
  ]
}
